{
  "check_interval": "30s",
  "timeout": "5s",
  "log_level": "info",
  "ports": [
    {
      "port": 8080,
      "name": "web"
    },
    {
      "port": 8081,
      "name": "api"
    },
    {
      "port": 5173,
      "name": "vite"
    },
    {
      "port": 4173,
      "name": "vite-preview"
    },
    {
      "port": 3306,
      "name": "mysql",
      "health": "tcp"
    },
    {
      "port": 5432,
      "name": "postgres",
      "health": "tcp"
    },
    {
      "port": 6379,
      "name": "redis"
    },
    {
      "port": 6378,
      "name": "redis-cluster"
    },
    {
      "port": 9090,
      "name": "prometheus",
      "health": "http://localhost:9090/-/healthy"
    },
    {
      "port": 9093,
      "name": "alertmanager",
      "health": "http://localhost:9093/-/ready"
    },
    {
      "port": 3000,
      "name": "grafana",
      "health": "https://localhost:3000/api/health",
      "insecure": true
    },
    {
      "port": 3100,
      "name": "loki",
      "health": "http://localhost:3100/ready"
    },
    {
      "port": 9009,
      "name": "mimir",
      "health": "http://localhost:9009/ready"
    },
    {
      "port": 8428,
      "name": "victoriametrics",
      "health": "http://localhost:8428/health"
    },
    {
      "port": 3200,
      "name": "tempo",
      "health": "http://localhost:3200/ready"
    },
    {
      "port": 8000,
      "name": "funasr",
      "health": "http://localhost:8000/health"
    },
    {
      "port": 22,
      "name": "ssh"
    },
    {
      "port": 11434,
      "name": "ollama"
    },
    {
      "port": 3113,
      "name": "agentmemory"
    },
    {
      "port": 8086,
      "name": "InfluxDB",
      "health": "http://localhost:8086/health"
    }
  ]
}
